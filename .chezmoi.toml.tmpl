{{- $home := (and (eq .chezmoi.os "darwin") (eq .chezmoi.hostname "mac-dev")) -}}
{{- $work := (and (eq .chezmoi.os "darwin") (eq .chezmoi.hostname "mac-work")) -}}

{{- $os := .chezmoi.os -}}
{{- if hasKey .chezmoi.osRelease "id" -}}
{{-     $os = printf "%s-%s" .chezmoi.os .chezmoi.osRelease.id -}}
{{- end -}}

[data]
home = {{ $home }}
work = {{ $work }}
os = {{ $os | quote }}

[edit]
command = "kak"
